@echo off
REM ==============================================================================
REM   🍬 سلسلة حلويات وزير الحلو — تشغيل التهيئة والإعداد لأول مرة
REM   Wazeer El-Helw POS — First-Time Auto-Installer & System Initializer
REM ==============================================================================

chcp 65001 >nul
TITLE [وزير الحلو] - إعداد وتهيئة نقطة البيع لأول مرة
COLOR 0A

ECHO.
ECHO  ==============================================================================
ECHO    🍬 ســلــســلــة حــلــويــات وزيــر الــحــلــو (Wazeer El-Helw)
ECHO    🚀 أداة الفحص والتثبيت التلقائي لنقطة البيع (Offline-First POS Setup)
ECHO  ==============================================================================
ECHO.
ECHO    جاري فحص بيئة التشغيل، وتثبيت البرامج الناقصة (Node.js / المتصفح)،
ECHO    وإنشاء مجلد فواتير إكسيل، ووضع اختصارات سطح المكتب الرسمية...
ECHO.

powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0setup-first-time.ps1"

IF %ERRORLEVEL% NEQ 0 (
    COLOR 0C
    ECHO.
    ECHO  [!] حدث تنبيه أو تعذر تشغيل سكريبت الإعداد بالكامل.
    ECHO      يرجى التحقق من أذونات النظام أو تشغيل الملف كمسؤول (Run as administrator).
    ECHO.
)

ECHO.
PAUSE
