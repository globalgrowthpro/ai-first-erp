{
  "info": {
    "_postman_id": "hafez-erp-pos-apis-collection",
    "name": "Hafez ERP — POS REST APIs",
    "description": "Complete collection of all Point of Sale APIs for Hafez ERP.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api/pos",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Orders & Checkout",
      "item": [
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders?branchId=korba&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [
                { "key": "branchId", "value": "korba" },
                { "key": "limit", "value": "50" }
              ]
            }
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/ord-1001",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "ord-1001"]
            }
          }
        },
        {
          "name": "Create Order (Checkout)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cashierId\": \"usr-korba\",\n  \"cashierName\": \"أحمد فريد\",\n  \"branchId\": \"korba\",\n  \"orderType\": \"takeaway\",\n  \"paymentMethod\": \"cash\",\n  \"items\": [\n    {\n      \"sku\": \"SKU-OM-ALI\",\n      \"nameAr\": \"طاجن أم علي بالمكسرات\",\n      \"nameEn\": \"Om Ali\",\n      \"quantity\": 2,\n      \"unitPrice\": 110\n    }\n  ],\n  \"tenderAmount\": 300\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "Update Order",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"محمود عبد الله\",\n  \"tableNumber\": \"T-VIP-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/ord-1001",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "ord-1001"]
            }
          }
        },
        {
          "name": "Patch Order Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"paid\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/ord-1001/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "ord-1001", "status"]
            }
          }
        },
        {
          "name": "Delete Order (Void)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/ord-1001",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "ord-1001"]
            }
          }
        },
        {
          "name": "Park Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cashierId\": \"usr-korba\",\n  \"branchId\": \"korba\",\n  \"items\": [\n    { \"sku\": \"SKU-KON-NAB\", \"nameAr\": \"كنافة نابلسية\", \"quantity\": 1, \"unitPrice\": 310 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/park",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "park"]
            }
          }
        },
        {
          "name": "Get Parked Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/parked",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "parked"]
            }
          }
        },
        {
          "name": "Refund Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refundAmount\": 345,\n  \"reason\": \"رغبة العميل في استبدال الصنف\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/ord-1001/refund",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "ord-1001", "refund"]
            }
          }
        }
      ]
    },
