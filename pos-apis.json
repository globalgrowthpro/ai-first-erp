          "description": "direct | talabat | elmenus | hungerstation | jahez | noon"
        },
        "cashierId": {
          "type": "string",
          "example": "usr-korba",
          "description": "Filter by cashier"
        },
        "search": {
          "type": "string",
          "example": "0100455",
          "description": "Search by order number or customer phone/name"
        },
        "limit": {
          "type": "number",
          "default": 50,
          "description": "Max records to return"
