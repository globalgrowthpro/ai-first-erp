{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Hafez ERP — Complete POS REST APIs Specification",
    "description": "Comprehensive specification for all Point of Sale (POS) APIs including Orders, Shifts, Cash Movements, Z-Reports, Products, Barcodes, Customers, Loyalty, Branches, Cashier PIN Authentication, and Offline Batch Sync.",
    "version": "1.0.0",
    "author": "Mr. Hafez Rahim - Hafez ERP Engineering",
    "baseUrl": "http://localhost:3001/api/pos",
    "supportedMethods": [
      "GET",
      "POST",
      "PUT",
      "PATCH",
      "DELETE",
      "OPTIONS"
    ]
  },
  "endpoints": [
    {
      "id": "health-check",
      "category": "System & Health",
      "method": "GET",
      "path": "/api/pos/health",
      "summary": "فحص جاهزية الخادم وحالة الاتصال السحابي (Health Check)",
      "description": "Returns POS server operational status, uptime, and cloud connectivity telemetry.",
      "headers": {
        "Content-Type": "application/json"
      },
      "queryParams": {},
      "requestBody": null,
      "responseExample": {
        "status": 200,
        "body": {
          "success": true,
          "data": {
            "status": "healthy",
            "uptime": 3600.45,
            "timestamp": "2026-11-16T00:00:00.000Z",
            "cloudSyncEnabled": true
          }
        }
      }
    },
    {
      "id": "cors-preflight",
      "category": "System & Health",
      "method": "OPTIONS",
      "path": "/api/pos/orders",
      "summary": "التحقق المسبق من تصاريح المتصفح (CORS Preflight)",
      "description": "Universal CORS preflight handler responding with allowed headers and methods.",
      "headers": {
        "Access-Control-Request-Method": "POST",
        "Access-Control-Request-Headers": "Content-Type, X-Terminal-Id"
      },
      "queryParams": {},
      "requestBody": null,
      "responseExample": {
        "status": 204,
        "headers": {
          "Access-Control-Allow-Origin": "*",
          "Access-Control-Allow-Methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS",
          "Access-Control-Allow-Headers": "Content-Type, Authorization, X-Requested-With, X-Terminal-Id, X-Branch-Id"
        }
      }
    },
    {
      "id": "auth-pin-verify",
      "category": "Authentication & Security",
      "method": "POST",
      "path": "/api/pos/auth/pin-verify",
      "summary": "تسجيل دخول الكاشير برمز PIN وإصدار توكن الجلسة المشفر (Cashier PIN Login)",
      "description": "Authenticates touchscreen cashier by 4-digit PIN, starts a secured 12h session, and returns cryptographic Bearer Token.",
      "headers": {
        "Content-Type": "application/json"
      },
      "queryParams": {},
      "requestBody": {
        "pin": "1234",
        "branchId": "korba",
        "terminalId": "term-01"
      },
      "responseExample": {
        "status": 200,
        "body": {
          "success": true,
          "message": "Authentication successful. Welcome أحمد فريد!",
          "data": {
            "sessionId": "sess-2026-abc123",
            "token": "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJ1c3Ita29yYmEiLCJyb2xlIjoiY2FzaGllciJ9.signature...",
            "cashierId": "usr-korba",
            "cashierName": "أحمد فريد",
            "branchId": "korba",
            "role": "cashier",
            "expiresAt": "2026-11-16T12:00:00.000Z"
          }
        }
      }
    },
    {
      "id": "auth-login",
      "category": "Authentication & Security",
      "method": "POST",
      "path": "/api/pos/auth/login",
      "summary": "تسجيل دخول المشرف / المدير العام (Supervisor/Manager Login)",
      "description": "Authenticates supervisors or administrators for managerial overrides, voids, and administrative operations.",
      "headers": {
        "Content-Type": "application/json"
      },
      "queryParams": {},
      "requestBody": {
        "username": "supervisor",
        "password": "Password123!",
        "branchId": "korba"
      },
      "responseExample": {
        "status": 200,
        "body": {
          "success": true,
          "message": "Manager login successful. Role: supervisor",
          "data": {
            "sessionId": "sess-2026-sup456",
            "token": "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJ1c3Itc3VwZXJ2aXNvciIsInJvbGUiOiJzdXBlcnZpc29yIn0...",
            "cashierId": "usr-supervisor",
            "cashierName": "مشرف الوردية العام",
            "role": "supervisor",
            "expiresAt": "2026-11-16T12:00:00.000Z"
          }
        }
      }
    },
    {
      "id": "auth-session",
      "category": "Authentication & Security",
      "method": "GET",
      "path": "/api/pos/auth/session",
      "summary": "التحقق من جلسة التوكن الحالية والصلاحيات (Verify Active Session)",
      "description": "Inspects caller Bearer token, verifying authenticity, non-revocation, expiration, and assigned RBAC permissions.",
      "headers": {
        "Authorization": "Bearer {{authToken}}"
      },
      "queryParams": {},
      "requestBody": null,
      "responseExample": {
        "status": 200,
        "body": {
          "success": true,
          "data": {
            "sessionId": "sess-2026-abc123",
            "cashierId": "usr-korba",
            "cashierName": "أحمد فريد",
            "role": "cashier",
            "permissions": [
              "orders:read",
              "orders:create",
              "shifts:open",
              "shifts:close"
            ]
          }
        }
      }
    },
    {
      "id": "auth-refresh",
      "category": "Authentication & Security",
      "method": "POST",
      "path": "/api/pos/auth/refresh",
      "summary": "تجديد توكن الجلسة (Refresh Session Token)",
      "description": "Issues a newly minted cryptographic token extending session TTL by 12 hours while revoking the former token.",
      "headers": {
        "Authorization": "Bearer {{authToken}}"
      },
      "queryParams": {},
      "requestBody": null,
      "responseExample": {
        "status": 200,
        "body": {
          "success": true,
          "message": "Session token refreshed successfully",
          "data": {
            "token": "eyJhbGciOiJIUzI1NiJ9.refreshed_signature...",
            "expiresAt": "2026-11-16T16:00:00.000Z"
          }
        }
      }
    },
    {
      "id": "auth-logout",
      "category": "Authentication & Security",
      "method": "POST",
      "path": "/api/pos/auth/logout",
      "summary": "تسجيل الخروج وإلغاء صلاحية التوكن فورياً (Revoke Token & Logout)",
      "description": "Adds the session token to the cryptographic blacklist/revocation registry, immediately rendering all future requests 401 Unauthorized.",
      "headers": {
        "Authorization": "Bearer {{authToken}}"
      },
      "queryParams": {},
      "requestBody": null,
      "responseExample": {
        "status": 200,
        "body": {
          "success": true,
          "message": "Logged out successfully. Token revoked.",
          "data": {
            "revoked": true
          }
        }
      }
    },
    {
      "id": "list-orders",
